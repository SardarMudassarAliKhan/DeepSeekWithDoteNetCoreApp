@model DeepSeekIntegration.Models.ChatViewModel
@{
    ViewData["Title"] = "DeepSeek-V4 Playground";
}

<div class="container py-4" style="max-width: 860px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-0">DeepSeek-V4 Assistant</h2>
            <small class="text-muted">Connected to Microsoft Foundry</small>
        </div>
        <span class="badge bg-success">Azure Foundry v1</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Index" method="post" id="chatForm">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="SystemPrompt" class="form-label fw-semibold"></label>
                    <input asp-for="SystemPrompt" class="form-control form-control-sm" />
                </div>

                <div class="mb-3">
                    <label asp-for="UserPrompt" class="form-label fw-semibold"></label>
                    <textarea asp-for="UserPrompt"
                              class="form-control"
                              rows="4"
                              placeholder="Ask DeepSeek-V4 anything..."></textarea>
                    <span asp-validation-for="UserPrompt" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary px-4" id="submitBtn">
                        <span id="btnText">Send Prompt</span>
                        <output id="btnSpinner" class="spinner-border spinner-border-sm ms-2 d-none" aria-label="Loading"></output>
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.AssistantReply))
    {
        <div class="card shadow-sm mt-4 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">DeepSeek-V4 Response</span>
                <small>
                    @Model.ElapsedMilliseconds ms
                    @if (Model.TotalTokensUsed is > 0)
                    {
                        <span> &bull; @Model.TotalTokensUsed tokens</span>
                    }
                </small>
            </div>
            <div class="card-body bg-light">
                <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@Model.AssistantReply</pre>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('chatForm').addEventListener('submit', function () {
            if ($(this).valid()) {
                document.getElementById('submitBtn').disabled = true;
                document.getElementById('btnText').textContent = 'Generating...';
                document.getElementById('btnSpinner').classList.remove('d-none');
            }
        });
    </script>
}